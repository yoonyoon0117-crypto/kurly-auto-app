{
  "name": "kurly-auto-app",
  "version": "2.1.0",
  "private": true,
  "description": "컬리 정기 장바구니 — 멀티유저 PWA (아이폰 홈 화면 추가) + Docker 배포",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development node server.js",
    "test": "node --test --test-concurrency=1 $(find test -maxdepth 1 -name '*.test.js' | sort)",
    "test:unit": "node --test --test-concurrency=1 $(find test -maxdepth 1 -name '*.test.js' ! -name 'live-*.test.js' | sort)",
    "test:live": "node --test --test-concurrency=1 test/live-kurly.test.js",
    "test:ui": "node scripts/ui-test.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "playwright": "1.65.1",
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": ">=20"
  }
}
