# ───────────────────────────────────────────────
#  컬리 정기 장바구니 — 환경변수 예시
#  cp .env.example .env  후 값을 채우세요. (.env 는 절대 공유·커밋 금지)
# ───────────────────────────────────────────────

# 서버 포트 (도커 안에서는 3000 으로 두고 바깥 포트만 바꾸는 것을 권장)
PORT=3000

# 초대 코드 — 회원가입할 때 필요한 암호 같은 문자열. 비우면 신규 가입이 막힙니다.
INVITE_CODE=change-me-invite-code

# 세션 서명 + 컬리 로그인 세션 암호화 키 (16자 이상, 길수록 좋음)
#   openssl rand -hex 32
APP_SECRET=change-me-to-a-long-random-string

# 사용자 데이터 저장 위치 (도커에서는 /data 볼륨)
DATA_DIR=./data

# 정기 실행 스케줄러 (false 로 두면 자동 실행 없이 수동 실행만)
SCHEDULER=on

# 실행 시각이 지난 뒤 몇 시간 안까지 "놓친 실행"을 따라잡을지
RUN_GRACE_HOURS=6

# 스케줄러 점검 주기(초)
SCHEDULER_INTERVAL_SECONDS=60

# 동시에 실행할 브라우저 수 — 작은 서버에서는 1 을 유지하세요 (메모리 보호)
MAX_CONCURRENT_RUNS=1

# HTTPS 뒤에 있을 때 쿠키 Secure 강제 (auto 면 X-Forwarded-Proto 를 따름)
# COOKIE_SECURE=auto

# 프록시(Railway·Fly·Caddy) 뒤에서 X-Forwarded-For 를 신뢰 (0 이면 무시)
TRUST_PROXY=1

# 도커에서 root 가 아닌 사용자로 Chromium 을 띄울 때 sandbox 문제가 있으면 1
# BROWSER_NO_SANDBOX=0

# 추가 Chromium 실행 인자 (공백으로 구분)
# BROWSER_ARGS=--disable-dev-shm-usage

# 브라우저 기본 타임아웃(ms)
# BROWSER_TIMEOUT_MS=20000

# 요청 로그를 남기려면 1
# LOG_REQUESTS=0
